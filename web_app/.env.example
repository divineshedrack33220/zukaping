# API base URL used by the web app.
#
# Leave this UNSET normally: the app probes every candidate backend on the first
# request (src/services/server-selector.ts) and talks to whichever one actually
# answers — your local Go backend while it runs, then the deployed services.
#
# Setting it only makes that host the preferred candidate. If it stops answering,
# the app still fails over to the others, so a suspended service cannot take the
# platform down on its own.
# VITE_API_URL=https://lemon16.onrender.com/api
# VITE_WS_URL=wss://lemon16.onrender.com/ws
#
# Note: https://zukaping.onrender.com is suspended by its owner, so it fails the
# probe. https://zukaping-backend.onrender.com (current code) and
# https://lemon16.onrender.com (older build) both answer.

# Google Sign-In client ID. PUBLIC value (it ships in the bundle) — copy from
# Google Cloud Console > Credentials. The matching client SECRET stays in
# backend/.env and must never appear here.
#
# Without this set, "Continue with Google" stays disabled.
# The serving origin must also be an "Authorized JavaScript origin" for that
# client, or the Google account chooser refuses to open (origin_mismatch).
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Where the dev server proxies /api and /ws (see vite.config.ts).
# Defaults to the local Go backend; point at a hosted one to test against it:
# DEV_API_TARGET=https://lemon16.onrender.com
