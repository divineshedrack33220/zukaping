# Copy this file to backend/.env and fill in your own values.
# .env is gitignored — never commit real credentials.
# Only CLOUDINARY_* is required to make image uploads work; the rest already
# have working defaults for local development.

# MongoDB (optional: falls back to mongodb://127.0.0.1:27017)
# MONGODB_URI=mongodb://127.0.0.1:27017

# JWT signing secret (required in GIN_MODE=release, must be >= 32 chars there)
# JWT_SECRET=

# Cloudinary — use ONE of the two shapes below.
# Shape A: single URL
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Shape B: three separate variables (this is the shape render.yaml provisions)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
