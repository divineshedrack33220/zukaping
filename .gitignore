# --- Secrets: real environment files never belong in a public repo ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Dependencies ---
node_modules/

# --- Build output ---
# Only the Vite output is ignored. backend/webapp/dist is the copy the Go binary
# embeds, and it has to be committed: Render's Go build image has no Node, so the
# client cannot be compiled during a deploy.
web_app/dist/
build/
*.tsbuildinfo
.vite/

# --- Compiled Go binaries and deploy artifacts ---
*.exe
*.exe~
*.dll
*.so
*.dylib
backend/app
backend/server
backend/coded
backend/lemon16-backend
backend/app-release.apk
*.test
*.out
coverage/

# --- Logs and local scratch ---
*.log
logs/
tmp/
temp/
server.log

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
